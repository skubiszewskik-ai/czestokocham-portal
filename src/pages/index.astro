---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import AdSlot from '../components/AdSlot.astro';
import Card from '../components/Card.astro';
import Row from '../components/Row.astro';
import Tag from '../components/Tag.astro';
import When from '../components/When.astro';
import Icon from '../components/Icon.astro';
import Carousel from '../components/Carousel.astro';
import { latest, featured, settings as getSettings, ads as getAds, type Article } from '../lib/db';
import { CATEGORIES, CATEGORY_KEYS, SITE, articleUrl, fmtWhen } from '../lib/site';

const all = latest({ limit: 60 });
const settings = getSettings();
const ads = getAds();
const withPic = (a: Article) => !!a.cover;
const lead = featured() || all.find(withPic) || all[0];
const rest = all.filter((a) => a.id !== lead?.id);
const side2 = rest.filter(withPic).slice(0, 2);
const top4 = rest.filter((a) => withPic(a) && !side2.includes(a)).slice(0, 4);
const used = new Set([lead?.id, ...side2.map((a) => a.id), ...top4.map((a) => a.id)]);
const miasto = latest({ category: 'miasto', limit: 20 }).filter((a) => !used.has(a.id) && a.cover).slice(0, 10);
const TOPICS = [['Raków', 'sport'], ['Włókniarz', 'sport'], ['Jasna Góra', ''], ['Aleja NMP', ''], ['Drogi i remonty', 'drogi'], ['Komunikacja MPK', 'MPK'], ['Szkoły', 'szkoła'], ['Kultura', 'koncert'], ['Inwestycje', 'inwestycja'], ['Budżet obywatelski', 'budżet obywatelski']];
const feed = all.filter((a) => !used.has(a.id)).slice(0, 36);
const ticker = all.slice(0, 7);
const sport = latest({ category: 'sport', limit: 4 });
const powiat = latest({ category: 'powiat', limit: 4 });
const kraj = latest({ category: 'kraj', limit: 4 });
const ctaPics = all.filter(withPic).slice(5, 8);

const counts: Record<string, number> = { all: feed.length };
for (const a of feed) counts[a.category] = (counts[a.category] || 0) + 1;
const tabs = [{ key: 'all', name: 'Wszystko' }, ...CATEGORY_KEYS.map((k) => ({ key: k, name: CATEGORIES[k].name }))];

const GMINY = ['Blachownia', 'Koniecpol', 'Olsztyn', 'Mstów', 'Konopiska', 'Poczesna', 'Kłomnice', 'Mykanów', 'Rędziny', 'Janów', 'Lelów', 'Przyrów', 'Kamienica Polska', 'Starcza', 'Dąbrowa Zielona', 'Kruszyna'];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: SITE.name,
  url: Astro.site?.toString(),
  logo: new URL('/logo.svg', Astro.site).toString(),
  sameAs: [SITE.facebook],
  email: SITE.email,
};
const li = lead?.cover?.srcset?.length ? lead.cover : null;
const preload = li ? { href: li.srcset[Math.min(1, li.srcset.length - 1)].url, srcset: li.srcset.map((v) => `${v.url} ${v.w}w`).join(', '), sizes: '(max-width: 900px) 100vw, 860px' } : null;
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent('Temat dla Częstokocham')}`;
---
<Base settings={settings} jsonld={jsonld} preload={preload} active="home">
  <h1 class="sr-only">Częstokocham – wiadomości z Częstochowy i powiatu</h1>

  {lead && (
    <section class="wrap bento" aria-label="Najważniejsze">
      <a class="lead-card b-lead" href={articleUrl(lead)}>
        <span class="lead-pic"><Pic img={lead.cover} sizes="(max-width: 900px) 100vw, 760px" eager alt="" /></span>
        <span class="lead-body">
          <span class="card-meta"><Tag cat={lead.category} dark /><When d={lead.publishedAt} /></span>
          <h2 class="lead-t">{lead.title}</h2>
          {lead.lead && <p class="lead-l">{lead.lead}</p>}
          <span class="lead-more">Czytaj <Icon name="arrow" /></span>
        </span>
      </a>
      {side2.map((a, i) => (
        <a class={`lead-card b-side b-side${i}`} href={articleUrl(a)}>
          <span class="lead-pic"><Pic img={a.cover} sizes="(max-width: 900px) 50vw, 380px" alt="" /></span>
          <span class="lead-body">
            <span class="card-meta"><Tag cat={a.category} dark /><When d={a.publishedAt} /></span>
            <h2 class="side-t">{a.title}</h2>
          </span>
        </a>
      ))}
      <aside class="live" aria-labelledby="h-live">
        <div class="live-h"><span class="pulse" aria-hidden="true"></span><h2 id="h-live">Na bieżąco</h2></div>
        <ol class="live-list">
          {ticker.filter((a) => a.id !== lead.id).slice(0, 6).map((a) => (
            <li>
              <a href={articleUrl(a)}>
                <time class="live-time num" datetime={a.publishedAt.toISOString()}>{fmtWhen(a.publishedAt)}</time>
                <span class="live-t">{a.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more-link" href="#wiadomosci">Wszystkie wiadomości <Icon name="arrow" /></a>
      </aside>
    </section>
  )}

  <nav class="wrap topics" aria-label="Popularne tematy">
    <span class="topics-l"><Icon name="bolt" /> Tematy</span>
    <ul>
      {TOPICS.map(([name, q]) => <li><a href={`/szukaj?q=${encodeURIComponent(q || name)}`}>{name}</a></li>)}
    </ul>
  </nav>

  {top4.length > 0 && (
    <section class="wrap grid4" aria-label="Wyróżnione">
      {top4.map((a, i) => <Card a={a} i={i} />)}
    </section>
  )}

  <div class="wrap section"><AdSlot slot="billboard" ads={ads} settings={settings} house /></div>

  {miasto.length > 3 && (
    <div class="wrap section">
      <Carousel title="Z Częstochowy" href="/miasto" linkText="Wszystkie" id="h-miasto">
        {miasto.map((a, i) => <Card a={a} i={i % 4} sizes="(max-width: 760px) 74vw, 320px" />)}
      </Carousel>
    </div>
  )}

  <section class="wrap section" id="wiadomosci" aria-labelledby="h-feed">
    <div class="feed-head rise">
      <h2 class="head accent" id="h-feed">Wszystkie wiadomości</h2>
      <div class="seg" role="tablist" aria-label="Filtruj według działu" data-seg>
        {tabs.map((t) => (
          <a href={t.key === 'all' ? '#wiadomosci' : `/${t.key}`} role="tab" data-filter={t.key} aria-selected={t.key === 'all' ? 'true' : 'false'} style={t.key !== 'all' ? `--c:${(CATEGORIES as any)[t.key].color}` : undefined}>
            {t.name}<span class="seg-n num">{counts[t.key] || 0}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="feed">
      <div class="feed-main">
        <div class="feed-list" data-feed>
          {feed.map((a, i) => (
            <div class="feed-item" data-cat={a.category} hidden={i >= 12 ? true : undefined}><Row a={a} /></div>
          ))}
        </div>
        <p class="feed-empty soft" hidden data-empty>W tym dziale nie ma jeszcze nowych wiadomości.</p>
        <div class="feed-more">
          <button class="btn ghost" type="button" data-more hidden={feed.length <= 12 ? true : undefined}>Pokaż więcej</button>
          <a class="btn" href="/miasto" data-all>Archiwum działu Miasto <Icon name="arrow" /></a>
        </div>
      </div>
      <aside class="feed-side">
        <div class="side-sticky">
          <AdSlot slot="sidebar" ads={ads} settings={settings} house />
          <AdSlot slot="list-inline" ads={ads} settings={settings} />
        </div>
      </aside>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="h-sport">
    <div class="sport">
      <div class="sport-bg" aria-hidden="true"></div>
      <div class="sport-head rise">
        <div>
          <span class="tag on-dark" style={`--c:${CATEGORIES.sport.color}`}>Sport</span>
          <h2 class="head" id="h-sport">Sport z Częstochowy</h2>
          <p class="sport-p">Piłka przy Limanowskiego, żużel przy Olsztyńskiej, hale i boiska w całym powiecie.</p>
        </div>
        <a class="btn white" href="/sport">Wszystko o sporcie <Icon name="arrow" /></a>
      </div>
      <div class="sport-grid">
        {sport.map((a, i) => <Card a={a} i={i} />)}
        {sport.length < 3 && (
          <>
            <a class="club rise" href="/szukaj?q=Raków"><strong>Raków</strong><span>Piłka nożna – zapowiedzi, relacje i wyniki meczów</span><span class="club-go">Wiadomości <Icon name="arrow" /></span></a>
            <a class="club rise" href="/szukaj?q=Włókniarz" style="--i:1"><strong>Włókniarz</strong><span>Żużel – składy, wyniki i atmosfera przy Olsztyńskiej</span><span class="club-go">Wiadomości <Icon name="arrow" /></span></a>
          </>
        )}
      </div>
    </div>
  </section>

  <div class="wrap section"><AdSlot slot="home-wide" ads={ads} settings={settings} /></div>

  <section class="wrap section" aria-labelledby="h-powiat">
    <div class="sec-head rise">
      <div>
        <h2 class="head accent" id="h-powiat">Powiat częstochowski</h2>
        <p class="soft sec-sub">16 gmin wokół Częstochowy. Wybierz swoją, żeby zobaczyć wiadomości.</p>
      </div>
      <a class="more-link" href="/powiat">Wszystkie z powiatu <Icon name="arrow" /></a>
    </div>
    <ul class="chips rise" style="--i:1">
      {GMINY.map((g) => <li><a href={`/szukaj?q=${encodeURIComponent(g)}`}><Icon name="pin" />{g}</a></li>)}
    </ul>
    {powiat.length > 0 && <div class="grid4 grid4--in">{powiat.map((a, i) => <Card a={a} i={i} />)}</div>}
  </section>

  {kraj.length > 0 && (
    <section class="wrap section" aria-labelledby="h-kraj">
      <div class="sec-head rise">
        <h2 class="head accent" id="h-kraj">Z kraju</h2>
        <a class="more-link" href="/kraj">Więcej <Icon name="arrow" /></a>
      </div>
      <div class="grid4">{kraj.map((a, i) => <Card a={a} i={i} />)}</div>
    </section>
  )}

  <section class="wrap section" aria-labelledby="h-cta">
    <div class="cta">
      <div class="cta-text rise">
        <h2 class="head" id="h-cta">Masz temat z Częstochowy?</h2>
        <p class="lead">Coś się dzieje na Twojej ulicy, w szkole albo na osiedlu? Napisz do nas – zdjęcia i filmy mile widziane. Odpisujemy codziennie.</p>
        <div class="cta-btns">
          <a class="btn white" href={mail}><Icon name="mail" /> Napisz do redakcji</a>
          <a class="btn cta-fb" href={SITE.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Facebook</a>
        </div>
      </div>
      <div class="cta-pics" aria-hidden="true">
        {ctaPics.map((a, i) => <span class={`ph cta-p cta-p${i}`}><Pic img={a.cover} sizes="300px" alt="" /></span>)}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var seg = document.querySelector('[data-seg]'), list = document.querySelector('[data-feed]');
      if (!seg || !list) return;
      var items = [].slice.call(list.children), more = document.querySelector('[data-more]'), all = document.querySelector('[data-all]'), empty = document.querySelector('[data-empty]');
      var cat = 'all', limit = 12;
      function render() {
        var shown = 0, total = 0;
        items.forEach(function (el) {
          var ok = cat === 'all' || el.dataset.cat === cat;
          if (ok) total++;
          el.hidden = !(ok && shown < limit);
          if (!el.hidden) shown++;
        });
        more.hidden = total <= limit;
        empty.hidden = total > 0;
        var k = cat === 'all' ? 'miasto' : cat, name = seg.querySelector('[data-filter="' + k + '"]').firstChild.textContent;
        all.firstChild.textContent = 'Archiwum działu ' + name + ' ';
        all.href = '/' + k;
      }
      seg.addEventListener('click', function (e) {
        var t = e.target.closest('[data-filter]');
        if (!t || e.metaKey || e.ctrlKey) return;
        e.preventDefault();
        cat = t.dataset.filter; limit = 12;
        seg.querySelectorAll('[data-filter]').forEach(function (x) { x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
        render();
      });
      more.addEventListener('click', function () { limit += 12; render(); });
    })();
  </script>
</Base>

<style>
  /* ---------- bento ---------- */
  .bento { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) 340px; grid-template-rows: repeat(2, minmax(250px, 1fr)); gap: 14px; margin-top: 22px; }
  .b-lead { grid-row: span 2; }
  .live { grid-column: 3; grid-row: 1 / span 2; }
  .lead-card { position: relative; display: block; border-radius: var(--r-xl); overflow: hidden; background: var(--navy); color: #fff; isolation: isolate; min-height: 0; }
  .lead-pic { position: absolute; inset: 0; }
  .lead-pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .lead-card:hover .lead-pic :global(img) { transform: scale(1.05); }
  .lead-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 11 25 / 0) 28%, rgb(10 11 25 / 0.5) 56%, rgb(10 11 25 / 0.94) 100%); z-index: 0; transition: opacity 0.3s; }
  .lead-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: clamp(18px, 2.6vw, 36px); display: flex; flex-direction: column; gap: 12px; }
  .lead-body .card-meta { color: rgb(255 255 255 / 0.85); }
  .lead-t { font-weight: 800; font-stretch: 88%; font-size: clamp(1.75rem, 1rem + 2.2vw, 3.1rem); line-height: 1.04; letter-spacing: -0.022em; text-wrap: balance; max-width: 20ch; }
  .side-t { font-weight: 750; font-size: clamp(1.05rem, 0.9rem + 0.4vw, 1.3rem); line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .b-side .lead-body { padding: 18px; gap: 10px; }
  .lead-l { font-size: 17px; line-height: 1.5; max-width: 60ch; color: rgb(255 255 255 / 0.9); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lead-more { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; width: fit-content; padding: 10px 16px; border-radius: 999px; background: #fff; color: var(--ink); transition: gap 0.25s var(--ease), background-color 0.2s, color 0.2s; }
  .lead-more :global(svg) { width: 18px; height: 18px; }
  .lead-card:hover .lead-more { gap: 12px; background: var(--red); color: #fff; }

  /* ---------- tematy ---------- */
  .topics { display: flex; align-items: center; gap: 14px; margin-top: 22px; }
  .topics-l { display: inline-flex; align-items: center; gap: 6px; font-weight: 800; font-size: 15px; white-space: nowrap; color: var(--red-ink); }
  .topics-l :global(svg) { width: 16px; height: 16px; fill: currentColor; stroke: none; }
  .topics ul { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent); padding-right: 40px; }
  .topics ul::-webkit-scrollbar { display: none; }
  .topics a { display: block; padding: 9px 15px; border-radius: 999px; background: var(--paper); font-weight: 600; font-size: 15px; white-space: nowrap; transition: background-color 0.2s, color 0.2s; }
  .topics a:hover { background: var(--ink); color: #fff; }

  .live { background: var(--paper); border-radius: var(--r-xl); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .live-h { display: flex; align-items: center; gap: 10px; }
  .live-h h2 { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; }
  .pulse { width: 10px; height: 10px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 0 rgb(227 20 27 / 0.5); animation: pulse 1.8s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgb(227 20 27 / 0); } 100% { box-shadow: 0 0 0 0 rgb(227 20 27 / 0); } }
  .live-list { flex: 1; }
  .live-list li + li { border-top: 1px solid var(--tone-2); }
  .live-list a { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 14px 0; }
  .live-time { color: var(--red-ink); font-weight: 700; font-size: 15px; padding-top: 1px; }
  .live-t { font-weight: 650; font-size: 16px; line-height: 1.32; transition: color 0.2s; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .live-list a:hover .live-t { color: var(--red-ink); }
  .live .more-link { padding-top: 8px; }

  .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 40px; }
  .grid4--in { margin-top: 32px; }

  /* ---------- lista ---------- */
  .feed-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 8px; }
  .seg { display: flex; gap: 4px; padding: 4px; background: var(--paper); border-radius: 999px; overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  .seg a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; font-weight: 650; font-size: 15px; white-space: nowrap; transition: background-color 0.2s, color 0.2s; }
  .seg a:hover { background: var(--tone-2); }
  .seg a[aria-selected='true'] { background: var(--ink); color: #fff; }
  .seg a[aria-selected='true']:not([data-filter='all']) { background: var(--c); }
  .seg-n { font-size: 12.5px; opacity: 0.7; }
  .feed { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
  .feed-item[hidden] { display: none; }
  .feed-empty { padding: 32px 0; }
  .feed-more { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .side-sticky { position: sticky; top: 100px; display: grid; gap: 28px; padding-top: 18px; }

  /* ---------- sport ---------- */
  .sport { position: relative; overflow: hidden; background: var(--navy); color: #fff; border-radius: var(--r-xl); padding: clamp(28px, 4vw, 56px); isolation: isolate; }
  .sport-bg { position: absolute; inset: auto -2% -6% auto; z-index: -1; pointer-events: none; }
  .sport-bg::before { content: 'Raków\AWłókniarz'; white-space: pre; display: block; text-align: right; font-weight: 900; font-stretch: 70%; font-size: clamp(90px, 15vw, 230px); line-height: 0.82; letter-spacing: -0.04em; color: rgb(255 255 255 / 0.05); }
  .sport-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .sport-head .head { margin-top: 14px; }
  .sport-p { margin-top: 10px; color: var(--on-navy-soft); max-width: 46ch; }
  .sport-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .sport-grid :global(.card-meta) { color: var(--on-navy-soft); }
  .sport-grid :global(.card:hover .card-t) { color: #ffb0a6; }
  .club { display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; padding: 24px; min-height: 260px; border-radius: var(--r-lg); background: var(--navy-2); transition: background-color 0.25s, transform 0.25s var(--ease); }
  .club strong { font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem); font-weight: 900; font-stretch: 75%; letter-spacing: -0.03em; line-height: 1; }
  .club span { color: var(--on-navy-soft); font-size: 16px; }
  .club .club-go { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-weight: 650; margin-top: 8px; }
  .club .club-go :global(svg) { width: 16px; height: 16px; }
  .club:hover { background: #2c3160; transform: translateY(-3px); }

  /* ---------- powiat ---------- */
  .sec-sub { margin-top: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px 10px 12px; border-radius: 999px; background: var(--paper); font-weight: 600; font-size: 15.5px; transition: background-color 0.2s, color 0.2s, transform 0.2s var(--ease); }
  .chips a :global(svg) { width: 16px; height: 16px; color: #0b7a54; }
  .chips a:hover { background: #0b7a54; color: #fff; transform: translateY(-2px); }
  .chips a:hover :global(svg) { color: #fff; }

  /* ---------- zgłoś temat ---------- */
  .cta { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; align-items: center; background: var(--red); color: #fff; border-radius: var(--r-xl); padding: clamp(28px, 4vw, 56px); overflow: hidden; }
  .cta-text { display: grid; gap: 16px; }
  .cta-text .lead { max-width: 44ch; }
  .cta-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .cta-fb { background: rgb(0 0 0 / 0.18); }
  .cta-fb:hover { background: var(--navy); box-shadow: none; }
  .cta-pics { position: relative; height: 300px; }
  .cta-p { position: absolute; width: 56%; aspect-ratio: 4 / 5; border-radius: var(--r-lg); box-shadow: 0 24px 50px -20px rgb(60 0 0 / 0.6); }
  .cta-p0 { left: 0; top: 10%; transform: rotate(-6deg); }
  .cta-p1 { left: 24%; top: -4%; transform: rotate(3deg); z-index: 1; }
  .cta-p2 { right: 0; top: 18%; transform: rotate(8deg); }

  @media (max-width: 1240px) {
    .bento { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-rows: repeat(2, minmax(220px, 1fr)) auto; }
    .live { grid-column: 1 / -1; grid-row: auto; }
    .live-list { columns: 2; column-gap: 32px; }
    .live-list li { break-inside: avoid; }
  }
  @media (max-width: 1100px) {
    .grid4, .sport-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feed { grid-template-columns: 1fr; }
    .feed-side { display: none; }
    .cta { grid-template-columns: 1fr; }
    .cta-pics { display: none; }
  }
  @media (max-width: 760px) {
    .bento { grid-template-columns: 1fr 1fr; grid-template-rows: none; gap: 10px; margin-top: 12px; }
    .b-lead { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 4 / 5; }
    .b-side { aspect-ratio: 3 / 4; }
