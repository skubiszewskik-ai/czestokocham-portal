---
export const prerender = true;
import '../../styles/global.css';
import { SLOTS } from '../../lib/slots';
import { CATEGORIES } from '../../lib/site';
const I = {
  home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  doc: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>',
  ad: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 15l2.5-6 2.5 6M7.8 13h3.4M15 9v6h1.5a2.5 2.5 0 0 0 0-5H15"/>',
  sync: '<path d="M20 11a8 8 0 0 0-14.6-4.5L4 8"/><path d="M4 4v4h4M4 13a8 8 0 0 0 14.6 4.5L20 16"/><path d="M20 20v-4h-4"/>',
  cog: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  ext: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  out: '<path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 16l-4-4 4-4M6 12h10"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  back: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  img: '<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>',
  trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  bolt: '<path d="M13 3 5 14h6l-1 7 8-11h-6z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  check: '<path d="M5 12.5 10 17l9-10"/>',
};
const ic = (k: keyof typeof I) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k]}</svg>`;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel redakcji – Częstokocham</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/admin/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/admin-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Panel CK" />
    <meta name="theme-color" content="#e3141b" />
  </head>
  <body class="adm">
    <!-- ============ LOGOWANIE ============ -->
    <section id="v-login" class="login">
      <div class="login-brand">
        <img src="/logo-dark.svg" width="220" height="137" alt="Częstokocham" />
        <h1>Panel redakcji</h1>
        <ul>
          <li>Artykuły z edytorem i galerią zdjęć</li>
          <li>Banery reklamowe z kontrolą wymiarów</li>
          <li>Automatyczny import z czestochowa.pl i wczestochowie.pl o 15:00</li>
          <li>Wirtualny redaktor – szkice z lokalnych portali do akceptu</li>
        </ul>
      </div>
      <div class="login-box">
        <div class="login-card">
          <h2>Zaloguj się</h2>
          <p>Użyj konta Google, które ma dostęp do panelu.</p>
          <button id="login" class="g-btn" type="button">
            <svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
            Zaloguj przez Google
          </button>
          <p id="login-err" class="login-err" hidden></p>
          <a class="login-back" href="/">← Wróć na stronę</a>
        </div>
      </div>
    </section>

    <!-- ============ APLIKACJA ============ -->
    <div id="app" class="app" hidden>
      <aside class="side" id="side">
        <a class="side-logo" href="/" target="_blank" rel="noopener"><img src="/logo-dark.svg" width="120" height="75" alt="Częstokocham" /></a>
        <nav class="side-nav" aria-label="Panel">
          <button data-tab="dashboard" aria-current="true"><Fragment set:html={ic('home')} /> Pulpit</button>
          <button data-tab="articles"><Fragment set:html={ic('doc')} /> Artykuły</button>
          <button data-tab="ads"><Fragment set:html={ic('ad')} /> Banery</button>
          <button data-tab="redaktor"><Fragment set:html={ic('spark')} /> Redaktor AI <span class="nav-n" id="red-n" hidden></span></button>
          <button data-tab="import"><Fragment set:html={ic('sync')} /> Import</button>
          <button data-tab="settings"><Fragment set:html={ic('cog')} /> Ustawienia</button>
        </nav>
        <div class="side-foot">
          <a class="side-link" href="/" target="_blank" rel="noopener"><Fragment set:html={ic('ext')} /> Zobacz stronę</a>
          <div class="me">
            <span class="me-ava" id="me-ava">?</span>
            <span class="me-mail" id="who"></span>
            <button id="logout" class="me-out" type="button" aria-label="Wyloguj" title="Wyloguj"><Fragment set:html={ic('out')} /></button>
          </div>
        </div>
      </aside>
      <div class="side-scrim" id="side-scrim"></div>

      <div class="main">
        <header class="topbar">
          <button class="burger" id="burger" type="button" aria-label="Menu"><Fragment set:html={ic('menu')} /></button>
          <h1 id="page-title">Pulpit</h1>
          <span id="pub" class="pub" role="status"><span class="pub-dot"></span><span class="pub-t">Sprawdzam…</span></span>
        </header>

        <div class="views">
          <!-- PULPIT -->
          <section id="v-dashboard" class="view">
            <div class="stats">
              <div class="stat"><span class="stat-l">Opublikowane</span><strong id="st-pub">–</strong><span class="stat-s">artykułów (ostatnie 200)</span></div>
              <div class="stat"><span class="stat-l">Dzisiaj</span><strong id="st-today">–</strong><span class="stat-s">nowych wiadomości</span></div>
              <div class="stat"><span class="stat-l">Banery</span><strong id="st-ads">–</strong><span class="stat-s">aktywnych</span></div>
              <div class="stat"><span class="stat-l">Ostatni import</span><strong id="st-imp">–</strong><span class="stat-s" id="st-imp-s">z czestochowa.pl i wczestochowie.pl</span></div>
            </div>
            <div class="quick">
              <button class="qa" data-go="new-article"><span class="qa-i red"><Fragment set:html={ic('plus')} /></span><span><strong>Nowy artykuł</strong><span>Napisz i opublikuj wiadomość</span></span></button>
              <button class="qa" data-go="new-ad"><span class="qa-i navy"><Fragment set:html={ic('ad')} /></span><span><strong>Nowy baner</strong><span>Dodaj reklamę klienta</span></span></button>
              <button class="qa" data-go="import"><span class="qa-i green"><Fragment set:html={ic('sync')} /></span><span><strong>Importuj teraz</strong><span>Pobierz nowości z czestochowa.pl i wczestochowie.pl</span></span></button>
            </div>
            <div class="card">
              <div class="card-h"><h2>Ostatnie artykuły</h2><button class="lnk" data-tab-go="articles">Wszystkie →</button></div>
              <div id="dash-list" class="alist"></div>
            </div>
          </section>

          <!-- ARTYKUŁY -->
          <section id="v-articles" class="view" hidden>
            <div class="toolbar">
              <label class="search"><Fragment set:html={ic('search')} /><input id="a-q" type="search" placeholder="Szukaj po tytule…" /></label>
              <div class="chips" id="a-cat">
                <button data-cat="" aria-pressed="true">Wszystkie</button>
                {Object.entries(CATEGORIES).map(([k, c]) => <button data-cat={k} style={`--c:${c.color}`}>{c.name}</button>)}
              </div>
              <button id="a-new" class="btn red"><Fragment set:html={ic('plus')} /> Nowy artykuł</button>
            </div>
            <div class="card flush"><div id="a-list" class="alist"></div></div>
            <div class="center"><button id="a-more" class="btn ghost" hidden>Pokaż starsze</button></div>
          </section>

          <!-- EDYTOR -->
          <section id="v-editor" class="view" hidden>
            <form id="e-form" novalidate>
              <div class="ebar">
                <button type="button" class="icon-btn" id="e-back" aria-label="Wróć do listy"><Fragment set:html={ic('back')} /></button>
                <span class="ebar-t" id="e-h">Nowy artykuł</span>
                <span class="ebar-sp"></span>
                <a id="e-view" class="btn ghost" target="_blank" hidden><Fragment set:html={ic('eye')} /> Podgląd</a>
                <button type="button" id="e-del" class="btn ghost danger" hidden><Fragment set:html={ic('trash')} /> Usuń</button>
                <button type="submit" class="btn red" id="e-save">Zapisz</button>
              </div>
              <div class="egrid">
                <div class="ecol">
                  <div class="card">
                    <textarea name="title" class="e-title" rows="1" placeholder="Tytuł artykułu" required maxlength="160"></textarea>
                    <div class="slug"><span class="slug-pre">czestokocham.pl/<span id="slug-cat">miasto</span>/</span><input name="slug" required pattern="[a-z0-9-]+" placeholder="adres-artykulu" /></div>
                    <textarea name="lead" class="e-lead" rows="2" maxlength="400" placeholder="Lead – 1–2 zdania wstępu, pogrubione pod tytułem"></textarea>
                  </div>
                  <div class="card rte-card">
                    <div class="rte-bar" role="toolbar" aria-label="Formatowanie">
                      <button type="button" data-cmd="bold" title="Pogrubienie"><b>B</b></button>
                      <button type="button" data-cmd="italic" title="Kursywa"><i>I</i></button>
                      <span class="sep"></span>
                      <button type="button" data-cmd="h2" title="Śródtytuł">H2</button>
                      <button type="button" data-cmd="p" title="Akapit">¶</button>
                      <button type="button" data-cmd="quote" title="Cytat">“ ”</button>
                      <span class="sep"></span>
                      <button type="button" data-cmd="ul" title="Lista">• Lista</button>
                      <button type="button" data-cmd="ol" title="Lista numerowana">1. Lista</button>
                      <button type="button" data-cmd="link" title="Link">Link</button>
                      <span class="sep"></span>
                      <button type="button" data-cmd="clear" title="Wyczyść formatowanie">Wyczyść</button>
                    </div>
                    <div id="rte" class="rte" contenteditable="true" data-ph="Zacznij pisać treść…"></div>
                  </div>
                  <div class="card">
                    <div class="card-h"><h2>Galeria</h2><span class="hint" id="gal-n"></span></div>
                    <div id="gal" class="thumbs"></div>
                    <label class="drop" data-drop="gal"><Fragment set:html={ic('img')} /><span><strong>Przeciągnij zdjęcia</strong> albo kliknij, aby wybrać</span><small>JPG, PNG, WebP – zamienimy na WebP</small><input id="gal-in" type="file" accept="image/*" multiple /></label>
                  </div>
                </div>
                <div class="ecol side-col">
                  <div class="card ai-note" id="e-ai" hidden>
                    <h2 class="ch"><Fragment set:html={ic('spark')} /> Szkic redaktora AI</h2>
                    <p id="e-ai-t"></p>
                    <button type="button" class="btn red wide" id="e-approve"><Fragment set:html={ic('check')} /> Zatwierdź i opublikuj</button>
                  </div>
                  <div class="card">
                    <h2 class="ch">Publikacja</h2>
                    <label>Status<select name="status"><option value="published">Opublikowany</option><option value="draft">Szkic</option></select></label>
                    <label>Dział<select name="category">{Object.entries(CATEGORIES).map(([k, c]) => <option value={k}>{c.name}</option>)}</select></label>
                    <label>Data publikacji<input name="publishedAt" type="datetime-local" required /></label>
                    <label class="switch"><input name="featured" type="checkbox" /><span class="sw"></span> Główny temat na stronie</label>
                  </div>
                  <div class="card">
                    <h2 class="ch">Zdjęcie główne</h2>
                    <p class="cnote" id="c-note" hidden></p>
                    <div id="cover" class="cover"></div>
                    <label class="drop small" data-drop="cover"><Fragment set:html={ic('img')} /><span><strong>Wybierz</strong>, upuść albo wklej <kbd>⌘V</kbd></span><small>Na innej stronie: prawy klik na zdjęciu → „Kopiuj obraz”</small><input id="cover-in" type="file" accept="image/*" /></label>
                    <div class="cacts">
                      <button type="button" class="btn ghost" id="c-ai"><Fragment set:html={ic('spark')} /> Nowa ilustracja AI</button>
                      <button type="button" class="btn ghost" id="c-find"><Fragment set:html={ic('search')} /> Wyszukaj zdjęcie</button>
                    </div>
                    <div class="cbox" id="c-ai-box" hidden>
                      <label>Co ma przedstawiać<textarea id="c-prompt" rows="3" placeholder="np. tram on a city street in autumn"></textarea></label>
                      <div id="c-ai-prev" class="cover"></div>
                      <div class="cbtns"><button type="button" class="btn ghost" id="c-ai-go">Generuj</button><button type="button" class="btn red" id="c-ai-use" hidden>Użyj tej</button></div>
                      <small class="hint">Grafikę tworzy automat (darmowy generator) – podgląd pojawi się tu po 2–6 minutach. Opis po angielsku działa najlepiej.</small>
                    </div>
                    <div class="cbox" id="c-find-box" hidden>
                      <label>Czego szukasz<input id="c-person" type="search" enterkeyhint="search" placeholder="np. komenda policji Myszków, Tomasz Kaczmarek" /></label>
                      <div class="cbtns"><a class="btn red" id="c-google" target="_blank" rel="noopener"><Fragment set:html={ic('ext')} /> Szukaj w Google Grafika</a><button type="button" class="btn ghost" id="c-find-go">Wikipedia</button></div>
                      <div id="c-res" class="thumbs pick"></div>
                      <small class="hint" id="c-res-n">W Google: prawy klik na zdjęciu → „Kopiuj obraz”, wróć tu i naciśnij ⌘V, potem wpisz autora zdjęć. Zdjęcia z Wikipedii mają wolną licencję – podpis uzupełni się sam.</small>
                    </div>
                    <label>Opis zdjęcia (alt)<input name="coverAlt" placeholder="Co widać na zdjęciu" /></label>
                    <label>Autor zdjęć<input name="photoCredit" placeholder="np. Jan Kowalski" /></label>
                  </div>
                  <div class="card">
                    <h2 class="ch">Autor i źródło</h2>
                    <label>Autor<input name="author" value="Redakcja" /></label>
                    <label>Źródło – nazwa<input name="sourceName" placeholder="np. czestochowa.pl" /></label>
                    <label>Źródło – adres<input name="sourceUrl" type="url" placeholder="https://" /></label>
                  </div>
                </div>
              </div>
            </form>
          </section>

          <!-- BANERY -->
          <section id="v-ads" class="view" hidden>
            <div class="toolbar">
              <p class="hint grow">Banery rotują losowo według wagi. Puste miejsce wypełnia reklama Google (jeśli włączona) albo zaproszenie do reklamy.</p>
              <button id="ad-new" class="btn red"><Fragment set:html={ic('plus')} /> Nowy baner</button>
            </div>
            <div id="ad-list" class="adgrid"></div>
            <div class="card">
              <div class="card-h"><h2>Miejsca reklamowe i wymiary</h2></div>
              <div class="slots">
                {Object.entries(SLOTS).map(([k, s]) => (
                  <div class="slot"><strong>{s.name}</strong><span class="num">{s.desktop.join('×')} px{s.mobile ? ` · tel. ${s.mobile.join('×')}` : ' · tylko komputer'}</span><small>{s.where}</small></div>
                ))}
              </div>
            </div>
          </section>

          <!-- IMPORT -->
          <section id="v-import" class="view" hidden>
            <div class="card import-hero">
              <span class="qa-i green big"><Fragment set:html={ic('sync')} /></span>
              <div class="grow">
                <h2>Import z czestochowa.pl i wczestochowie.pl</h2>
                <p>Codziennie po 15:00 automat pobiera nowe aktualności z <a href="https://www.czestochowa.pl/aktualnosci" target="_blank" rel="noopener">czestochowa.pl/aktualnosci</a> oraz z <a href="https://wczestochowie.pl/" target="_blank" rel="noopener">wczestochowie.pl</a> razem ze zdjęciami (WebP) i publikuje je z dopiskiem „Źródło: …” i odnośnikiem do oryginału. Artykuły sponsorowane z wczestochowie.pl są pomijane. Zaimportowane artykuły możesz edytować – kolejny import ich nie nadpisze.</p>
              </div>
              <button id="imp-run" class="btn red"><Fragment set:html={ic('bolt')} /> Importuj teraz</button>
            </div>
            <div class="card flush">
              <div class="card-h pad"><h2>Historia</h2></div>
              <table class="tbl"><thead><tr><th>Kiedy</th><th>Uruchomienie</th><th>Sprawdzono</th><th>Nowe</th><th>Błędy</th></tr></thead><tbody id="imp-list"></tbody></table>
            </div>
          </section>

          <!-- REDAKTOR AI -->
          <section id="v-redaktor" class="view" hidden>
            <div class="card import-hero">
              <span class="qa-i violet big"><Fragment set:html={ic('spark')} /></span>
              <div class="grow">
                <h2>Wirtualny redaktor</h2>
                <p>Co 2 godziny (7:00–21:00) sprawdza lokalne portale. Z nowych tematów pisze <strong>własne teksty</strong> na podstawie faktów i zostawia je tutaj jako szkice. Nic nie trafia na stronę bez Twojej akceptacji. Czeka najwyżej 30 propozycji – gdy przybywa nowych, najstarsze nieprzejrzane są usuwane razem ze zdjęciami. Pomija reklamy, tematy spoza regionu i wiadomości, które już mamy (np. z czestochowa.pl). Zdjęć konkurencji nie używa: bierze zdjęcie z banku poniżej, z Wikimedia Commons (z podpisem autora) albo robi planszę z tytułem.</p>
                <p class="hint" id="red-last">Ostatnie uruchomienie: –</p>
              </div>
              <button id="red-run" class="btn red"><Fragment set:html={ic('bolt')} /> Uruchom teraz</button>
            </div>

            <div class="card flush">
              <div class="card-h pad"><h2>Szkice do akceptu</h2><span class="hint" id="red-count"></span></div>
              <div id="red-list" class="rlist"></div>
            </div>

            <div class="card">
              <div class="card-h"><h2>Bank zdjęć redakcji</h2><span class="hint" id="bank-n"></span></div>
              <p class="hint">Wgraj własne lub kupione zdjęcia i opisz je słowami kluczowymi (np. <em>Raków, stadion, piłka nożna</em> albo <em>policja, radiowóz</em>). Redaktor dobierze zdjęcie, którego słowa najlepiej pasują do tematu.</p>
              <div class="grid2">
                <label>Słowa kluczowe (po przecinku)<input id="bank-tags" placeholder="np. MPK, tramwaj, komunikacja" /></label>
                <label>Autor / źródło zdjęcia<input id="bank-credit" placeholder="np. Redakcja Częstokocham" /></label>
              </div>
              <label class="drop" data-drop="bank"><Fragment set:html={ic('img')} /><span><strong>Przeciągnij zdjęcia</strong> albo kliknij, aby wybrać</span><small>Wszystkie wybrane zdjęcia dostaną powyższe słowa kluczowe</small><input id="bank-in" type="file" accept="image/*" multiple /></label>
              <div id="bank" class="bank"></div>
            </div>

            <div class="card">
              <h2 class="ch">Ilustracje AI</h2>
              <label class="switch"><input id="red-ai" type="checkbox" /><span class="sw"></span> Twórz ilustracje AI, gdy brak zdjęcia w banku i w Wikimedia</label>
              <p class="hint">Darmowa usługa Pollinations: obraz ma w rogu logo pollinations.ai, usługa może przestać działać bez uprzedzenia, a jej regulamin każe samodzielnie sprawdzić licencję modelu przed użyciem komercyjnym. Przy wyłączonej opcji redaktor zrobi planszę z tytułem.</p>
            </div>

            <div class="card flush">
              <div class="card-h pad"><h2>Historia</h2></div>
