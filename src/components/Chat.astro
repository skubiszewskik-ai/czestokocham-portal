---
// Asystent Częstokocham: czat z AI. Strona jest statyczna, więc pytania idą do Workera Cloudflare (worker/index.js),
// który trzyma klucze i dokłada wiedzę portalu (/kontekst.json). Bez SITE.chatApi czat się nie pokazuje.
import { SITE } from '../lib/site';
interface Props { path?: string }
const { path = '/' } = Astro.props;
const api = SITE.chatApi;

// podpowiedzi zależne od strony: action „brief” = Częstochowa w 60 sekund, „plan” = planer dnia,
// „page” = pytanie o artykuł lub wydarzenie, na którego stronie jest czytelnik
type Hint = { label: string; q?: string; action?: 'brief' | 'plan' | 'page' };
const brief: Hint = { label: 'Częstochowa w 60 sekund', action: 'brief' };
const plan: Hint = { label: 'Zaplanuj mi dzień', action: 'plan' };
const hints: Hint[] = /^\/wydarzenia\/[^/]+/.test(path)
  ? [
      { label: 'Jak tam dojechać?', q: 'Jak dojechać na to wydarzenie, np. komunikacją miejską?', action: 'page' },
      { label: 'Co zjeść w pobliżu?', q: 'Gdzie w pobliżu tego miejsca można coś zjeść albo usiąść na kawę?', action: 'page' },
      { label: 'Co jeszcze tego dnia?', q: 'Co jeszcze dzieje się w Częstochowie tego dnia?', action: 'page' },
      plan,
    ]
  : /^\/(miasto|powiat|kraj|sport)\/[^/]+/.test(path)
    ? [
        { label: 'Streść ten artykuł', q: 'Streść ten tekst w 3 punktach.', action: 'page' },
        { label: 'Wyjaśnij kontekst', q: 'Wyjaśnij kontekst tej sprawy – skąd się wzięła i dlaczego jest ważna?', action: 'page' },
        brief,
        { label: 'Co nowego w mieście?' },
      ]
    : path.startsWith('/wydarzenia')
      ? [plan, { label: 'Co w ten weekend?' }, { label: 'Coś dla dzieci?', q: 'Jakie wydarzenia dla dzieci są w najbliższych dniach?' }, { label: 'Koncerty w tym tygodniu', q: 'Jakie koncerty są w tym tygodniu?' }]
      : path.startsWith('/sport')
        ? [{ label: 'Kiedy gra Raków?', q: 'Kiedy najbliższy mecz Rakowa Częstochowa?' }, { label: 'Co we Włókniarzu?', q: 'Co nowego we Włókniarzu Częstochowa?' }, brief, { label: 'Sport w weekend', q: 'Jakie wydarzenia sportowe są w ten weekend w Częstochowie?' }]
        : [brief, plan, { label: 'Co dziś w mieście?', q: 'Jakie są dziś wydarzenia?' }, { label: 'Jaka będzie pogoda?', q: 'Jaka będzie pogoda w najbliższych dniach?' }, { label: 'Opowiedz o Jasnej Górze' }];
---
{api && (
  <div class="chat" data-chat={api}>
    <section class="chat-panel" id="chat-panel" role="dialog" aria-label="Asystent Częstokocham" hidden>
      <header class="chat-head">
        <span class="chat-av" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9zM18.5 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"/></svg></span>
        <div class="chat-title">
          <strong>Asystent Częstokocham</strong>
          <span>Pytaj o miasto, wydarzenia i okolicę</span>
        </div>
        <button class="chat-x" type="button" aria-label="Nowa rozmowa" title="Nowa rozmowa" data-chat-reset hidden><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"/></svg></button>
        <button class="chat-x" type="button" aria-label="Zamknij czat" data-chat-close><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </header>
      <div class="chat-about" data-chat-about hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h5"/></svg>
        <p><span data-chat-about-l>Rozmowa o artykule:</span> <strong data-chat-about-t></strong></p>
        <button type="button" aria-label="Zakończ rozmowę o tej stronie" title="Zakończ rozmowę o tej stronie" data-chat-about-x><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>
      <div class="chat-log" role="log" aria-live="polite" aria-relevant="additions text" data-chat-log>
        <div class="chat-msg bot"><div class="chat-b">Cześć! Jestem asystentem Częstokocham. Znam najnowsze wiadomości i wydarzenia z Częstochowy, a o resztę zapytam internet. W czym pomóc?</div></div>
        <div class="chat-hints" data-chat-hints>
          {hints.map((h) => <button type="button" class={`chat-hint${h.action === 'brief' || h.action === 'plan' ? ' star' : ''}`} data-q={h.q || h.label} data-action={h.action}>{h.label}</button>)}
        </div>
      </div>
      <form class="chat-form" data-chat-form autocomplete="off">
        <textarea rows="1" maxlength="1000" placeholder="Zadaj pytanie…" aria-label="Twoje pytanie" data-chat-input></textarea>
        <button class="chat-mic" type="button" aria-label="Zadaj pytanie głosem" title="Zadaj pytanie głosem" aria-pressed="false" data-chat-mic hidden><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
        <button class="chat-send" type="submit" aria-label="Wyślij" data-chat-send><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </form>
      <p class="chat-note">Odpowiada sztuczna inteligencja i może się mylić. Ważne informacje sprawdź w źródle.</p>
    </section>
    <button class="chat-fab" type="button" aria-expanded="false" aria-controls="chat-panel" data-chat-open>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9zM18.5 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"/></svg>
      <span>Zapytaj asystenta</span>
    </button>
  </div>
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-chat]');
      if (!root || !window.fetch || !window.ReadableStream) { if (root) root.hidden = true; return; }
      var api = root.dataset.chat.replace(/\/$/, '') + '/chat';
      var panel = root.querySelector('.chat-panel'), fab = root.querySelector('[data-chat-open]');
      var log = root.querySelector('[data-chat-log]'), form = root.querySelector('[data-chat-form]');
      var input = root.querySelector('[data-chat-input]'), send = root.querySelector('[data-chat-send]');
      var hints = root.querySelector('[data-chat-hints]');
      var KEY = 'ck-chat', history = [], about = null, busy = false, ctrl = null;
      // rozmowa trwa przy przechodzeniu między stronami portalu, ale odświeżenie strony albo 30 min ciszy zaczyna ją od nowa
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      try {
        var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
        if (saved && saved.at > Date.now() - 30 * 60e3 && !(nav && nav.type === 'reload')) { history = saved.m || []; about = saved.about || null; }
        else sessionStorage.removeItem(KEY);
      } catch (e) {}
      var save = function () { try { sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), m: history.slice(-12), about: about })); } catch (e) {} };
      // do AI idą tylko 3 ostatnie wymiany, a długie odpowiedzi przycięte – mniej tokenów na pytanie
      var forAi = function () { return history.slice(-6).map(function (m) { return { role: m.role, content: m.role === 'assistant' && m.content.length > 700 ? m.content.slice(0, 700) + '…' : m.content }; }); };

      // linki: tylko istniejące strony portalu (lista z /kontekst.json + działy) i nigdy do lokalnej konkurencji
      var SECTIONS = ['/', '/miasto', '/powiat', '/kraj', '/sport', '/wydarzenia', '/szukaj', '/o-nas', '/reklama'];
      var RIVALS = /(^|\.)(wczestochowie\.pl|czestochowskie\.pl|czestochowskie24\.pl|czestochowaonline\.pl|gazetacz\.com\.pl|zycieczestochowy\.pl|zycieregionu\.com\.pl|gazetaregionalna\.com|miejska\.pl|sport\.czest\.pl|wpowiecie\.pl|radiojura\.pl|fiat\.fm|wyborcza\.pl|naszemiasto\.pl|dziennikzachodni\.pl)$/i;
      var known = null;
      function loadKnown() {
        if (known) return;
        known = new Set(SECTIONS);
        fetch('/kontekst.json').then(function (r) { return r.json(); }).then(function (j) {
          (j.news || []).concat(j.events || []).forEach(function (x) { if (x.u) known.add(x.u); });
          known.ready = true;
          // odpowiedzi narysowane przed wczytaniem listy – rysujemy jeszcze raz
          [].forEach.call(log.querySelectorAll('.chat-b[data-md]'), function (b) { b.innerHTML = render(b.dataset.md); });
        }).catch(function () {});
      }
      function linkOk(u) {
        if (u.charAt(0) === '/') {
          var path = u.split(/[?#]/)[0].replace(/\/$/, '') || '/';
          return known && (SECTIONS.indexOf(path) > -1 || known.has(path) || !known.ready && /^\/(wydarzenia|miasto|powiat|kraj|sport)\/[a-z0-9-]+$/.test(path));
        }
        try { var h = new URL(u).hostname.replace(/^www\./, ''); } catch (e) { return false; }
        if (h === 'czestokocham.pl') return linkOk(new URL(u).pathname);
        return !RIVALS.test(h);
      }

      // bezpieczny, minimalny markdown: najpierw ucieczka HTML, potem linki, pogrubienia i listy
      function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
      function inline(s) {
        s = esc(s);
        s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (m, t, u) {
          u = u.replace(/&amp;/g, '&');
          if (!/^https?:\/\//i.test(u) && u.charAt(0) !== '/') return t;
          if (!linkOk(u)) return t;
          var ext = /^https?:/i.test(u) && !/^https?:\/\/(www\.)?czestokocham\.pl/i.test(u);
          return '<a href="' + esc(u) + '"' + (ext ? ' target="_blank" rel="noopener noreferrer"' : '') + '>' + t + '</a>';
        });
        // model czasem pisze „**Tytuł** (/wydarzenia/slug)” zamiast linku – zamieniamy na link
        s = s.replace(/\*\*([^*]+)\*\*\s*\((\/[a-z0-9\/-]+)\)/g, function (m, t, u) { return linkOk(u) ? '<a href="' + u + '"><strong>' + t + '</strong></a>' : '<strong>' + t + '</strong>'; });
        s = s.replace(/\s?\((\/[a-z0-9\/-]+)\)/g, function (m, u) { return linkOk(u) ? ' (<a href="' + u + '">szczegóły</a>)' : ''; });
        return s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/(^|[\s(])\*([^*\s][^*]*?)\*(?=[\s.,;:!?)]|$)/g, '$1$2');
      }
      function render(md) {
        md = md.replace(/【[^】]*】/g, '');
        md = md.replace(/^\s*\*\*[^*\n]+\?\*\*\s*\n+/, ''); // pogrubione powtórzenie pytania na początku
        var out = '', list = false;
        md.split('\n').forEach(function (line) {
          // wiersze tabel zamieniamy na punkty listy, separatory tabel pomijamy
          if (/^\s*\|?[\s:|-]+\|[\s:|-]*$/.test(line)) return;
          if (/^\s*\|.*\|\s*$/.test(line)) line = '- ' + line.replace(/^\s*\||\|\s*$/g, '').split('|').map(function (c) { return c.trim(); }).filter(Boolean).join(' – ');
          var li = line.match(/^\s*(?:[*\-•]|\d+\.)\s+(.*)/);
          if (li) { if (!list) { out += '<ul>'; list = true; } out += '<li>' + inline(li[1]) + '</li>'; return; }
          if (list) { out += '</ul>'; list = false; }
          if (line.trim()) out += '<p>' + inline(line.replace(/^#{1,4}\s+/, '')) + '</p>';
        });
        return out + (list ? '</ul>' : '');
      }

      function add(role, text) {
        var m = document.createElement('div'); m.className = 'chat-msg ' + (role === 'user' ? 'me' : 'bot');
        var b = document.createElement('div'); b.className = 'chat-b';
        if (role === 'user') b.textContent = text; else { b.dataset.md = text; b.innerHTML = render(text); }
        m.appendChild(b); log.appendChild(m); log.scrollTop = log.scrollHeight;
        return b;
      }
      var pending = [], resetBtn = root.querySelector('[data-chat-reset]'), aboutBar = root.querySelector('[data-chat-about]');
      // rozmowa o konkretnym artykule (blok „Zapytaj o ten artykuł”) – Worker sam pobiera jego treść ze strony
      function setAbout(a) {
        about = a; aboutBar.hidden = !a;
        aboutBar.querySelector('[data-chat-about-t]').textContent = a ? a.title : '';
        var ev = a && a.path.indexOf('/wydarzenia/') === 0;
        aboutBar.querySelector('[data-chat-about-l]').textContent = ev ? 'Rozmowa o wydarzeniu:' : 'Rozmowa o artykule:';
        input.placeholder = a ? (ev ? 'Zapytaj o to wydarzenie…' : 'Zapytaj o ten artykuł…') : 'Zadaj pytanie…';
        if (hints) hints.hidden = !!(a || history.length);
      }
      function clear() {
        if (ctrl) ctrl.abort();
        stopSpeaking();
        history = []; try { sessionStorage.removeItem(KEY); } catch (e) {}
        [].forEach.call(log.querySelectorAll('.chat-msg'), function (m, i) { if (i) m.remove(); });
        resetBtn.hidden = true; setAbout(null);
      }
      history.forEach(function (m) { var b = add(m.role, m.label || m.content); if (m.role === 'assistant') pending.push([b, m.content]); });
      if (history.length) resetBtn.hidden = false;
      setAbout(about);
      resetBtn.addEventListener('click', function () { clear(); input.focus(); });
      aboutBar.querySelector('[data-chat-about-x]').addEventListener('click', function () { setAbout(null); save(); input.focus(); });
      addEventListener('ck-ask', function (e) {
        var d = e.detail || {};
        if (busy || !d.q) return;
        if (!about || about.path !== d.path) clear();
        setAbout({ path: d.path, title: d.title });
        open(); ask(d.q);
      });

      function open() {
        loadKnown(); panel.hidden = false; fab.setAttribute('aria-expanded', 'true'); root.classList.add('open');
        document.documentElement.classList.add('chat-on');
        log.scrollTop = log.scrollHeight; setTimeout(function () { input.focus(); }, 60);
      }
      function close() {
        panel.hidden = true; fab.setAttribute('aria-expanded', 'false'); root.classList.remove('open');
        document.documentElement.classList.remove('chat-on'); fab.focus();
      }
      fab.addEventListener('click', function () { panel.hidden ? open() : close(); });
      root.querySelector('[data-chat-close]').addEventListener('click', close);
      addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) close(); });
      if (hints) hints.addEventListener('click', function (e) {
        var b = e.target.closest('.chat-hint');
        if (!b) return;
        var a = b.dataset.action;
        if (a === 'brief') return startBrief(false);
        if (a === 'plan') return startPlan();
        if (a === 'page') {
          var h1 = document.querySelector('h1');
          setAbout({ path: location.pathname.replace(/\/$/, ''), title: h1 ? h1.textContent.trim() : document.title });
        }
        ask(b.dataset.q, { label: b.textContent });
      });

      // --- głos: pytanie mikrofonem (rozpoznawanie mowy przeglądarki) i odczyt odpowiedzi na głos ---
      var SR = window.SpeechRecognition || window.webkitSpeechRecognition, mic = root.querySelector('[data-chat-mic]'), rec = null;
      if (SR && mic) {
        mic.hidden = false;
        mic.addEventListener('click', function () {
          if (rec) { rec.stop(); return; }
          rec = new SR(); rec.lang = 'pl-PL'; rec.interimResults = true; rec.maxAlternatives = 1;
          var before = input.value;
          rec.onresult = function (e) {
            var t = ''; for (var i = 0; i < e.results.length; i++) t += e.results[i][0].transcript;
            input.value = (before ? before + ' ' : '') + t; grow();
          };
          rec.onend = function () { rec = null; mic.setAttribute('aria-pressed', 'false'); mic.classList.remove('rec'); if (input.value.trim() && input.value !== before) form.requestSubmit(); };
          rec.onerror = function () { mic.classList.remove('rec'); };
          mic.setAttribute('aria-pressed', 'true'); mic.classList.add('rec');
          try { rec.start(); } catch (e) { rec = null; mic.classList.remove('rec'); }
        });
      }
      // odczyt: naturalny głos Gemini z Workera (/tts), a gdy niedostępny (limit) – najlepszy polski głos przeglądarki
      var synth = window.speechSynthesis, speaking = null, session = null, player = new Audio();
      var ttsApi = api.replace(/\/chat$/, '/tts');
      var SILENT = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA=';
      // iOS pozwala grać dźwięk tylko po geście – „odblokowujemy” odtwarzacz w chwili kliknięcia
      function unlock() { try { player.src = SILENT; var p = player.play(); if (p) p.catch(function () {}); } catch (e) {} }
      function plainText(md) {
        return md.replace(/【[^】]*】/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/\(\/[^)\s]*\)/g, '').replace(/https?:\/\/\S+/g, '')
          .replace(/[*#|_]/g, '').replace(/^\s*[-•]\s+/gm, '').replace(/\s+/g, ' ').trim();
      }
      // pierwsza część krótka (szybki start), kolejne dłuższe – Gemini oddaje nagranie dopiero w całości
      function parts(t) {
        var sent = t.match(/[^.!?…]+[.!?…]*\s*/g) || [t], out = [], cur = '';
        sent.forEach(function (x) {
          x = x.trim(); if (!x) return;
          var lim = [150, 330, 650][Math.min(out.length, 2)];
          if (cur && (cur + ' ' + x).length > lim) { out.push(cur); cur = x; } else cur = cur ? cur + ' ' + x : x;
        });
        if (cur) out.push(cur);
        return out.map(function (x) { return x.slice(0, 690); });
      }
      function bestVoice() {
        var score = function (v) { var n = v.name; return (/natural|neural|online/i.test(n) ? 4 : 0) + (/premium|enhanced|ulepsz/i.test(n) ? 3 : 0) + (/google/i.test(n) ? 2 : 0) + (v.localService ? 0 : 1); };
        return synth.getVoices().filter(function (v) { return /^pl/i.test(v.lang); }).sort(function (a, b) { return score(b) - score(a); })[0];
      }
      function setBtn(btn, state) {
        btn.classList.toggle('on', state !== 'off'); btn.classList.toggle('wait', state === 'wait');
        btn.textContent = state === 'wait' ? 'Przygotowuję głos…' : state === 'on' ? 'Zatrzymaj' : 'Odsłuchaj';
      }
      function stopSpeaking() {
        session = null;
        try { player.pause(); } catch (e) {}
        if (synth) synth.cancel();
        if (speaking) { setBtn(speaking, 'off'); speaking = null; }
      }
      function browserSpeak(text, btn, s) {
        if (session !== s) return; // w międzyczasie zaczęto czytać coś innego
        if (!synth) return stopSpeaking();
        var u = new SpeechSynthesisUtterance(text); u.lang = 'pl-PL'; u.rate = 1.02;
        var v = bestVoice(); if (v) u.voice = v;
        u.onend = u.onerror = function () { if (session === s) stopSpeaking(); };
        setBtn(btn, 'on'); synth.speak(u);
      }
      function speak(text, btn) {
        var again = speaking === btn; stopSpeaking(); if (again) return;
        var s = session = {}, list = parts(plainText(text)), jobs = [];
        speaking = btn; setBtn(btn, 'wait');
        function get(i) {
          if (i >= list.length) return null;
          return jobs[i] || (jobs[i] = fetch(ttsApi, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text: list[i] }) })
            .then(function (r) { if (!r.ok) throw new Error('tts'); return r.blob(); }));
        }
        get(0); get(1);
        (function play(i) {
          if (session !== s) return;
          if (i >= list.length) return stopSpeaking();
          get(i).then(function (blob) {
            if (session !== s) return;
            get(i + 1); get(i + 2);
            setBtn(btn, 'on');
            var url = URL.createObjectURL(blob);
            player.onended = function () { URL.revokeObjectURL(url); play(i + 1); };
            player.src = url;
            var p = player.play(); if (p) p.catch(function () { browserSpeak(list.slice(i).join(' '), btn, s); });
          }).catch(function () { browserSpeak(list.slice(i).join(' '), btn, s); });
        })(0);
      }
      function addSpeak(bubble, text, auto) {
        if (!text) return;
        var b = document.createElement('button'); b.type = 'button'; b.className = 'chat-speak'; b.textContent = 'Odsłuchaj';
        b.addEventListener('click', function () { unlock(); speak(text, b); });
        bubble.parentNode.appendChild(b);
        if (auto) speak(text, b);
      }

      // --- Częstochowa w 60 sekund: podsumowanie dnia (pogoda, wiadomości, wieczór) ---
      function startBrief(withVoice) {
        if (busy) return;
        clear(); open();
        // iOS odtwarza mowę tylko po geście użytkownika – „odblokowujemy” ją od razu przy kliknięciu
        if (withVoice) unlock();
        ask('Częstochowa w 60 sekund – podsumuj dzisiejszy dzień w mieście.', { mode: 'brief', label: 'Częstochowa w 60 sekund', speak: withVoice });
      }

      // --- planer dnia: krótki formularz w czacie, potem plan z kalendarza i pogody ---
      function startPlan() {
        if (busy) return;
        clear(); open();
        var days = ['Dziś', 'Jutro', 'W sobotę', 'W niedzielę'];
        var groups = [
          ['Kiedy', days],
          ['Z kim', ['Sam / sama', 'We dwoje', 'Z dziećmi', 'Ze znajomymi']],
          ['Klimat', ['Kultura', 'Aktywnie', 'Na spokojnie', 'Jedzenie i kawa']],
          ['Budżet', ['Za darmo', 'Do 50 zł', 'Bez limitu']],
        ];
        var m = document.createElement('div'); m.className = 'chat-msg bot';
        var html = '<form class="chat-b chat-plan"><p>Ułożę Ci plan dnia w Częstochowie z wydarzeniami z naszego kalendarza i prognozą pogody. Wybierz:</p>';
        groups.forEach(function (g, gi) {
          html += '<div class="chat-plan-g" role="radiogroup" aria-label="' + g[0] + '"><span>' + g[0] + '</span><div>';
          g[1].forEach(function (o, oi) { html += '<button type="button" role="radio" aria-checked="' + (oi === 0) + '" data-g="' + gi + '">' + o + '</button>'; });
          html += '</div></div>';
        });
        m.innerHTML = html + '<button type="submit" class="chat-plan-go">Ułóż plan</button></form>';
        if (hints) hints.hidden = true;
        log.appendChild(m); log.scrollTop = 0;
        var f = m.querySelector('form');
        f.addEventListener('click', function (e) {
          var b = e.target.closest('[role=radio]'); if (!b) return;
          [].forEach.call(f.querySelectorAll('[data-g="' + b.dataset.g + '"]'), function (x) { x.setAttribute('aria-checked', String(x === b)); });
        });
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var pick = groups.map(function (g, gi) { return f.querySelector('[data-g="' + gi + '"][aria-checked="true"]').textContent; });
          ask('Zaplanuj mi dzień w Częstochowie. Kiedy: ' + pick[0].toLowerCase() + '. Z kim: ' + pick[1].toLowerCase() + '. Klimat: ' + pick[2].toLowerCase() + '. Budżet: ' + pick[3].toLowerCase() + '.',
            { mode: 'plan', label: 'Plan dnia: ' + pick.join(', ').toLowerCase() });
        });
      }
      pending.forEach(function (x) { addSpeak(x[0], x[1]); });
      addEventListener('ck-chat', function (e) {
        var d = e.detail || {};
        if (d.action === 'brief') startBrief(!!d.speak);
        else if (d.action === 'plan') startPlan();
      });

      function grow() { input.style.height = ''; if (input.value) input.style.height = Math.min(input.scrollHeight, 120) + 'px'; }
      input.addEventListener('input', grow);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); } });
      form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });

      function ask(q, opts) {
        opts = opts || {};
        q = (q || '').trim();
        if (!q || busy) return;
        busy = true; send.disabled = true; input.value = ''; grow(); stopSpeaking();
        if (hints) hints.hidden = true;
        add('user', opts.label || q); history.push({ role: 'user', content: q, label: opts.label }); resetBtn.hidden = false;
        var bubble = add('bot', ''); bubble.classList.add('typing'); bubble.innerHTML = '<i></i><i></i><i></i>';
        var text = '';
        ctrl = new AbortController();
        fetch(api, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: forAi(), article: about ? about.path : undefined, mode: opts.mode }), signal: ctrl.signal })
          .then(function (res) {
            if (!res.ok) return res.json().catch(function () { return {}; }).then(function (j) { throw new Error(j.error || 'Coś poszło nie tak. Spróbuj ponownie.'); });
            var rd = res.body.getReader(), dec = new TextDecoder(), buf = '';
            function pump() {
              return rd.read().then(function (r) {
                if (r.done) return;
                buf += dec.decode(r.value, { stream: true });
                var parts = buf.split('\n\n'); buf = parts.pop();
                parts.forEach(function (p) {
                  p.split('\n').forEach(function (l) {
                    if (l.indexOf('data:') !== 0) return;
                    var d = l.slice(5).trim(); if (!d || d === '[DONE]') return;
                    try {
                      var c = JSON.parse(d).choices[0].delta.content;
                      if (c) { text += c; bubble.classList.remove('typing'); bubble.dataset.md = text; bubble.innerHTML = render(text); log.scrollTop = log.scrollHeight; }
                    } catch (e) {}
                  });
                });
                return pump();
              });
            }
            return pump();
          })
          .then(function () {
            if (!text) throw new Error('Nie udało się wygenerować odpowiedzi. Spróbuj inaczej sformułować pytanie.');
            history.push({ role: 'assistant', content: text }); save();
            addSpeak(bubble, text, opts.speak);
          })
          .catch(function (err) {
            history.pop(); save();
            bubble.classList.remove('typing'); bubble.classList.add('err'); delete bubble.dataset.md;
            bubble.textContent = text || (err && err.name !== 'AbortError' ? err.message : 'Przerwano.');
            if (!/Spróbuj|spróbuj/.test(bubble.textContent)) bubble.textContent += ' Spróbuj ponownie za chwilę.';
          })
          .finally(function () { busy = false; send.disabled = false; ctrl = null; input.focus(); });
      }
    })();
  </script>
)}

