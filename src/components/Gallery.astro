---
// Galeria artykułu (pierwsze zdjęcie = zdjęcie główne, otwierane kliknięciem w nie): mozaika + pełnoekranowy podgląd ze strzałkami, licznikiem, miniaturami, gestem przesunięcia i klawiaturą
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import type { Img } from '../lib/db';
interface Props { images: Img[]; credit?: string | null; title: string }
const { images, credit, title } = Astro.props;
const n = images.length - 1; // zdjęcia w galerii (bez głównego)
const big = (g: Img) => g.srcset[g.srcset.length - 1].url;
const small = (g: Img) => g.srcset[0].url;
const shown = images.slice(1, 6);
const data = images.map((g) => ({ src: big(g), w: g.w, h: g.h, t: small(g) }));
---
{n > 0 && <section class="gal" aria-labelledby="h-gal">
  <div class="gal-head">
    <h2 class="gal-h" id="h-gal"><Icon name="camera" /> Galeria</h2>
    <button class="gal-open" type="button" data-open="1">Otwórz galerię <span class="num">({n})</span> <Icon name="arrow" /></button>
  </div>
  <div class:list={['gal-grid', `gal-n${Math.min(n, 5)}`]}>
    {shown.map((g, i) => (
      <button class="g ph" type="button" data-open={i + 1} aria-label={`Zdjęcie ${i + 1} z ${n}`}>
        <Pic img={g} sizes={i === 0 ? '(max-width: 760px) 100vw, 520px' : '(max-width: 760px) 50vw, 260px'} alt="" />
        {i === 4 && n > 5 && <span class="g-more">+{n - 5}</span>}
        <span class="g-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
      </button>
    ))}
  </div>
</section>}

<dialog class="lb" aria-label={`Galeria: ${title}`} data-lb>
  <div class="lb-top">
    <span class="lb-count num" data-count>1 / {images.length}</span>
    <span class="lb-cap">{credit ? `Fot. ${credit}` : ''}</span>
    <button class="lb-btn" type="button" data-close aria-label="Zamknij"><Icon name="close" /></button>
  </div>
  <div class="lb-stage" data-stage>
    <button class="lb-nav lb-prev" type="button" data-prev aria-label="Poprzednie zdjęcie"><Icon name="arrow" /></button>
    <img class="lb-img" data-img alt="" />
    <button class="lb-nav lb-next" type="button" data-next aria-label="Następne zdjęcie"><Icon name="arrow" /></button>
  </div>
  <div class="lb-thumbs" data-thumbs>
    {data.map((d, i) => <button type="button" data-go={i} aria-label={`Zdjęcie ${i + 1}`}><img data-src={d.t} alt="" width="96" height="64" /></button>)}
  </div>
</dialog>

<script is:inline define:vars={{ data }}>
  (function () {
    var d = document.querySelector('[data-lb]');
    if (!d || !d.showModal) return;
    var img = d.querySelector('[data-img]'), count = d.querySelector('[data-count]'), thumbs = d.querySelectorAll('[data-go]'), i = 0;
    function show(k) {
      i = (k + data.length) % data.length;
      img.classList.remove('in');
      img.onload = function () { img.classList.add('in'); };
      img.src = data[i].src;
      count.textContent = i + 1 + ' / ' + data.length;
      thumbs.forEach(function (t, j) { t.toggleAttribute('aria-current', j === i); });
      if (thumbs[i]) thumbs[i].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      new Image().src = data[(i + 1) % data.length].src; // wczytaj następne zawczasu
    }
    function open(k) {
      d.querySelectorAll('img[data-src]').forEach(function (t) { t.src = t.dataset.src; t.removeAttribute('data-src'); });
      d.showModal();
      document.documentElement.style.overflow = 'hidden';
      show(k);
    }
    d.addEventListener('close', function () { document.documentElement.style.overflow = ''; });
    document.querySelectorAll('[data-open]').forEach(function (b) { b.addEventListener('click', function () { open(+b.dataset.open); }); });
    var cover = document.querySelector('[data-cover-open]');
    if (cover) cover.addEventListener('click', function () { open(0); });
    d.querySelector('[data-prev]').addEventListener('click', function () { show(i - 1); });
    d.querySelector('[data-next]').addEventListener('click', function () { show(i + 1); });
    d.querySelector('[data-close]').addEventListener('click', function () { d.close(); });
    thumbs.forEach(function (t) { t.addEventListener('click', function () { show(+t.dataset.go); }); });
    d.addEventListener('keydown', function (e) { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    d.addEventListener('click', function (e) { if (e.target === d || e.target.hasAttribute('data-stage')) d.close(); });
    // przesunięcie palcem
    var x0 = null, stage = d.querySelector('[data-stage]');
    stage.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
    stage.addEventListener('pointerup', function (e) { if (x0 === null) return; var dx = e.clientX - x0; x0 = null; if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1)); });
  })();
</script>

<style>
  .gal { margin-top: 44px; }
  .gal-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .gal-h { display: flex; align-items: center; gap: 10px; font-size: 24px; font-weight: 800; letter-spacing: -0.01em; }
  .gal-open { display: inline-flex; align-items: center; gap: 6px; border: 0; background: var(--paper); padding: 10px 16px; border-radius: 999px; font-weight: 650; font-size: 15px; cursor: pointer; transition: background-color 0.2s, color 0.2s, gap 0.25s var(--ease); }
  .gal-open :global(svg) { width: 16px; height: 16px; }
  .gal-open:hover { background: var(--ink); color: #fff; gap: 10px; }
  .gal-grid { display: grid; gap: 8px; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 150px; }
  .gal-n1 { grid-template-columns: 1fr; grid-auto-rows: 420px; }
  .gal-n2 { grid-template-columns: 1fr 1fr; grid-auto-rows: 300px; }
  .gal-n3 { grid-template-columns: 2fr 1fr; }
  .gal-n3 .g:first-child { grid-row: span 2; }
  .gal-n4 .g:first-child, .gal-n5 .g:first-child { grid-column: span 2; grid-row: span 2; }
  .gal-n4 .g:nth-child(4) { grid-column: span 2; }
  .g { position: relative; border: 0; padding: 0; cursor: zoom-in; border-radius: var(--r-md); }
  .g :global(img) { transition: transform 0.6s var(--ease), filter 0.3s; }
  .g:hover :global(img) { transform: scale(1.06); }
  .g-more { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(17 19 38 / 0.62); color: #fff; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; }
  .g-zoom { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 999px; background: rgb(255 255 255 / 0.92); color: var(--ink); opacity: 0; transform: scale(0.8); transition: opacity 0.2s, transform 0.25s var(--ease); }
  .g:hover .g-zoom { opacity: 1; transform: none; }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #090a16; color: #fff; }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; animation: lbin 0.3s var(--ease); }
  @keyframes lbin { from { opacity: 0; } }
  .lb::backdrop { background: transparent; }
  .lb-top { display: flex; align-items: center; gap: 16px; padding: 14px 18px; }
  .lb-count { font-weight: 700; background: rgb(255 255 255 / 0.1); padding: 6px 12px; border-radius: 999px; font-size: 15px; }
  .lb-cap { flex: 1; color: rgb(255 255 255 / 0.7); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb-btn, .lb-nav { display: grid; place-items: center; border: 0; cursor: pointer; color: #fff; background: rgb(255 255 255 / 0.12); border-radius: 999px; transition: background-color 0.2s, transform 0.2s var(--ease); }
  .lb-btn { width: 46px; height: 46px; }
  .lb-btn:hover, .lb-nav:hover { background: var(--red); }
  .lb-stage { position: relative; display: grid; place-items: center; min-height: 0; padding: 0 80px; touch-action: pan-y; }
  .lb-img { max-width: 100%; max-height: calc(100dvh - 200px); object-fit: contain; border-radius: 10px; opacity: 0; transform: scale(0.98); transition: opacity 0.3s, transform 0.4s var(--ease); user-select: none; -webkit-user-drag: none; }
  .lb-img:global(.in) { opacity: 1; transform: none; }
  .lb-nav { position: absolute; top: 50%; width: 56px; height: 56px; margin-top: -28px; }
  .lb-nav :global(svg) { width: 24px; height: 24px; }
  .lb-prev { left: 16px; }
  .lb-prev :global(svg) { transform: rotate(180deg); }
  .lb-next { right: 16px; }
  .lb-nav:active { transform: scale(0.92); }
  .lb-thumbs { display: flex; gap: 8px; padding: 14px 18px 18px; overflow-x: auto; scrollbar-width: none; justify-content: safe center; }
  .lb-thumbs button { flex: none; padding: 0; border: 0; border-radius: 8px; overflow: hidden; cursor: pointer; opacity: 0.45; outline: 2px solid transparent; outline-offset: 2px; transition: opacity 0.2s, outline-color 0.2s; background: #222; }
  .lb-thumbs button[aria-current] { opacity: 1; outline-color: #fff; }
  .lb-thumbs button:hover { opacity: 0.85; }
  .lb-thumbs img { width: 84px; height: 56px; object-fit: cover; display: block; }
  @media (max-width: 760px) {
    .gal-grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 120px; }
    .gal-n4 .g:first-child, .gal-n5 .g:first-child { grid-column: span 2; grid-row: span 2; }
    .gal-n4 .g:nth-child(4) { grid-column: span 2; }
    .gal-n5 .g:nth-child(5) { grid-column: span 2; }
    .gal-n3 { grid-template-columns: 1fr 1fr; }
    .gal-n3 .g:first-child { grid-column: span 2; grid-row: span 2; }
    .lb-stage { padding: 0 8px; }
    .lb-nav { width: 44px; height: 44px; margin-top: -22px; background: rgb(0 0 0 / 0.45); }
    .lb-prev { left: 10px; }
    .lb-next { right: 10px; }
  }
</style>
