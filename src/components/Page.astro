---
// Prosta strona tekstowa na osi
import Base from '../layouts/Base.astro';
import { settings as getSettings } from '../lib/db';
interface Props { title: string; description?: string; lede?: string }
const { title, description, lede } = Astro.props;
const settings = await getSettings();
---
<Base title={title} description={description} settings={settings}>
  <section class="wrap pg">
    <div class="pg-side"><h1 class="t-l">{title}</h1>{lede && <p class="lead pg-lede">{lede}</p>}</div>
    <div class="pg-body"><slot /></div>
  </section>
</Base>
<style>
  .pg { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 48px; padding-top: clamp(32px, 5vw, 72px); }
  .pg-side { position: sticky; top: 110px; align-self: start; background: var(--paper); border-radius: var(--r-xl); padding: clamp(24px, 3vw, 40px); }
    .pg-lede { margin-top: 20px; max-width: 30ch; }
  .pg-body { max-width: 68ch; }
  .pg-body :global(h2) { font-size: 1.5rem; font-weight: 750; line-height: 1.2; margin: 1.8em 0 0.5em; }
  .pg-body :global(h2:first-child) { margin-top: 0; }
  .pg-body :global(p), .pg-body :global(ul) { margin-bottom: 1em; }
  .pg-body :global(ul) { list-style: disc; padding-left: 1.2em; }
  .pg-body :global(a) { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .pg-body :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; margin: 1em 0 1.6em; font-size: 16px; border-radius: var(--r-md); overflow: hidden; background: var(--paper); }
  .pg-body :global(th), .pg-body :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--tone-2); vertical-align: top; }
  .pg-body :global(th) { background: var(--tone-2); font-weight: 700; }
  @media (max-width: 900px) { .pg { grid-template-columns: 1fr; gap: 32px; } .pg-side { position: static; } }
</style>
